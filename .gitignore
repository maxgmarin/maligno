# ── Rust / Cargo ──────────────────────────────────────────────────────────────
# Compiled output
/target/
debug/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows debug info
*.pdb

# Cargo mutation testing output
**/mutants.out*/

# ── Large bioinformatics test data ────────────────────────────────────────────
# SAM and BAM files can be hundreds of MB — keep out of git
*.sam
*.bam
*.bam.bai

# Outputs from running the README test-data example
test_data/test_results/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ── Editors / IDEs ────────────────────────────────────────────────────────────
# VS Code
.vscode/

# JetBrains (RustRover, CLion, etc.)
.idea/
*.iml

# Vim/Neovim
*.swp
*.swo
*~

# ── Misc ──────────────────────────────────────────────────────────────────────
# Environment files
.env
.env.local
